# Copy this file to .env and fill in real values. .env is gitignored -- never commit secrets.
#
# For pods, do NOT bake keys into the Docker image. Instead store them once as
# RunPod account-level Secrets and reference them from a pod template's environment
# variables; every pod launched from the template then gets them injected at boot.
# Locally, this .env is the single source of truth.

# the red / blue / green agents
ANTHROPIC_API_KEY=
# judges and the sandbagging monitor
OPENROUTER_API_KEY=
# write scope: datasets and adapters
HF_TOKEN=
GIT_TOKEN=
# optional
WANDB_API_KEY=
# Only needed later, for automated pod provisioning via the RunPod API:
RUNPOD_API_KEY=
